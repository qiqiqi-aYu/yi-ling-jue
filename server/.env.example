# server/.env.example —— 复制为 .env 后按本机情况修改（.env 不要提交到仓库）
# 数据库连接（schema.sql 建的就是 yi_ling_jue 库）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=yi_ling_jue
DB_POOL_SIZE=10

# 平衡配置缓存时长（毫秒）；后台改完数值可调 /admin/config 后立即刷新
BALANCE_CACHE_TTL_MS=60000

# 后续阶段使用（本阶段 engine/config 不需要）
PORT=3000
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
WX_APPID=
WX_SECRET=
